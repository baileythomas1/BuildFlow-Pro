// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PM
  EMPLOYEE
  CLIENT

  @@map("role")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETE

  @@map("project_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

enum FileVisibility {
  INTERNAL
  CLIENT

  @@map("file_visibility")
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED

  @@map("estimate_status")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE

  @@map("invoice_status")
}

// PRD 11: has many Users, Projects, Clients, AuditLogs
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  clients   Client[]
  projects  Project[]
  auditLogs AuditLog[]

  @@map("companies")
}

// PRD 11: belongs to Company; has many assigned Tasks
// password_hash + tokenVersion support email/password auth (PRD 9.1, 14) with
// short-lived access tokens + rotating refresh tokens (tokenVersion bump revokes
// all outstanding refresh tokens, e.g. on logout or password change).
model User {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  role                   Role
  name                   String
  tokenVersion           Int       @default(0) @map("token_version")
  // Login brute-force stopgap (see lib/auth/login-attempts.ts): failedLoginAttempts
  // counts failures since failedLoginWindowStart; both reset on a successful login.
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  failedLoginWindowStart DateTime? @map("failed_login_window_start")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id])
  assignedTasks Task[]         @relation("TaskAssignee")
  uploadedFiles File[]         @relation("FileUploader")
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditLogActor")
  clientProfile Client?

  @@index([companyId])
  @@map("users")
}

// PRD 11: belongs to Company; has one Project (Phase 1: 1 client per project).
// user_id is a nullable link to the homeowner's portal login (a User with role CLIENT).
model Client {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  email     String
  userId    String?  @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects Project[]

  @@index([companyId])
  @@map("clients")
}

// PRD 11: belongs to Company & Client; has many Tasks, Files, Estimates, Invoices
// PRD 9.2: "health" (On Track/At Risk/Delayed) is computed from tasks, never stored.
// archivedAt: soft-delete per CLAUDE.md conventions (never hard-delete Projects).
model Project {
  id         String        @id @default(uuid()) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  clientId   String        @map("client_id") @db.Uuid
  name       String
  address    String
  budget     Decimal       @db.Decimal(12, 2)
  status     ProjectStatus @default(PLANNING)
  startDate  DateTime?     @map("start_date")
  targetDate DateTime?     @map("target_date")
  archivedAt DateTime?     @map("archived_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id])
  client    Client     @relation(fields: [clientId], references: [id])
  tasks     Task[]
  files     File[]
  estimates Estimate[]
  invoices  Invoice[]

  @@index([companyId])
  @@index([clientId])
  @@map("projects")
}

// PRD 11: belongs to Project; belongs to User (assignee)
// order: not in the original PRD 11 field list, added to support PRD 9.3's
// drag-and-drop reordering — position within its (projectId, status) column,
// resequenced to a dense 0..n-1 range on every move (see lib/tasks/reorder.ts).
model Task {
  id         String     @id @default(uuid()) @db.Uuid
  projectId  String     @map("project_id") @db.Uuid
  assigneeId String?    @map("assignee_id") @db.Uuid
  title      String
  status     TaskStatus @default(TODO)
  order      Int        @default(0) @map("position")
  dueDate    DateTime?  @map("due_date")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id])
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

// PRD 11: belongs to Project
model File {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  uploaderId  String         @map("uploader_id") @db.Uuid
  storagePath String         @map("storage_path")
  visibility  FileVisibility @default(INTERNAL)
  type        String
  createdAt   DateTime       @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id])
  uploader User    @relation("FileUploader", fields: [uploaderId], references: [id])

  @@index([projectId])
  @@map("files")
}

// PRD 11: belongs to Project; has many EstimateLineItems
// archivedAt: soft-delete per CLAUDE.md (financial records are never hard-deleted).
// Per CLAUDE.md, an approved Estimate is immutable — changes create a new Change
// Order record rather than an edit; that record is out of scope for this prompt.
model Estimate {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @map("project_id") @db.Uuid
  status     EstimateStatus @default(DRAFT)
  total      Decimal        @db.Decimal(12, 2)
  approvedAt DateTime?      @map("approved_at")
  archivedAt DateTime?      @map("archived_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  project   Project            @relation(fields: [projectId], references: [id])
  lineItems EstimateLineItem[]
  invoices  Invoice[]

  @@index([projectId])
  @@map("estimates")
}

// PRD 9.5: line items with quantity, unit cost, markup.
model EstimateLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(12, 2)
  markup      Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  estimate Estimate @relation(fields: [estimateId], references: [id])

  @@index([estimateId])
  @@map("estimate_line_items")
}

// PRD 11: belongs to Project
// archivedAt: soft-delete per CLAUDE.md (financial records are never hard-deleted).
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  estimateId      String?       @map("estimate_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(PENDING)
  stripePaymentId String?       @map("stripe_payment_id")
  archivedAt      DateTime?     @map("archived_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id])
  estimate Estimate? @relation(fields: [estimateId], references: [id])

  @@index([projectId])
  @@index([estimateId])
  @@map("invoices")
}

// PRD 11: belongs to User
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  readAt    DateTime? @map("read_at")
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// PRD 11: belongs to Company
// entityId is a polymorphic reference (no FK constraint) to the affected row,
// identified alongside entityType.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  actor   User    @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([companyId])
  @@map("audit_logs")
}

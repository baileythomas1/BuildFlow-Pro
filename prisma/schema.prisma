// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PM
  EMPLOYEE
  CLIENT

  @@map("role")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETE

  @@map("project_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE

  @@map("task_status")
}

enum FileVisibility {
  INTERNAL
  CLIENT

  @@map("file_visibility")
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED

  @@map("estimate_status")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE

  @@map("invoice_status")
}

// PRD 11: has many Users, Projects, Clients, AuditLogs
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  clients   Client[]
  projects  Project[]
  auditLogs AuditLog[]

  @@map("companies")
}

// PRD 11: belongs to Company; has many assigned Tasks
// password_hash + tokenVersion support email/password auth (PRD 9.1, 14) with
// short-lived access tokens + rotating refresh tokens (tokenVersion bump revokes
// all outstanding refresh tokens, e.g. on logout or password change).
// hourlyRate: PRD 9.7 roster field, not in the original PRD 11 list — nullable
// since it's only meaningful for billable roles, not every account.
model User {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  role                   Role
  name                   String
  hourlyRate             Decimal?  @map("hourly_rate") @db.Decimal(8, 2)
  tokenVersion           Int       @default(0) @map("token_version")
  // Login brute-force stopgap (see lib/auth/login-attempts.ts): failedLoginAttempts
  // counts failures since failedLoginWindowStart; both reset on a successful login.
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  failedLoginWindowStart DateTime? @map("failed_login_window_start")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id])
  assignedTasks      Task[]              @relation("TaskAssignee")
  uploadedFiles      File[]              @relation("FileUploader")
  notifications      Notification[]
  auditLogs          AuditLog[]          @relation("AuditLogActor")
  changeOrders       ChangeOrder[]       @relation("ChangeOrderCreator")
  statusComments     StatusComment[]     @relation("StatusCommentAuthor")
  projectAssignments ProjectAssignment[]
  clientProfile      Client?

  @@index([companyId])
  @@map("users")
}

// PRD 11: belongs to Company; has one Project (Phase 1: 1 client per project).
// user_id is a nullable link to the homeowner's portal login (a User with role CLIENT).
model Client {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  email     String
  userId    String?  @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id])
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  projects Project[]

  @@index([companyId])
  @@map("clients")
}

// PRD 11: belongs to Company & Client; has many Tasks, Files, Estimates, Invoices
// PRD 9.2: "health" (On Track/At Risk/Delayed) is computed from tasks, never stored.
// archivedAt: soft-delete per CLAUDE.md conventions (never hard-delete Projects).
model Project {
  id         String        @id @default(uuid()) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  clientId   String        @map("client_id") @db.Uuid
  name       String
  address    String
  budget     Decimal       @db.Decimal(12, 2)
  status     ProjectStatus @default(PLANNING)
  startDate  DateTime?     @map("start_date")
  targetDate DateTime?     @map("target_date")
  archivedAt DateTime?     @map("archived_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id])
  client             Client              @relation(fields: [clientId], references: [id])
  tasks              Task[]
  files              File[]
  estimates          Estimate[]
  invoices           Invoice[]
  statusComments     StatusComment[]
  projectAssignments ProjectAssignment[]

  @@index([companyId])
  @@index([clientId])
  @@map("projects")
}

// PRD 9.7: "who is assigned to what" — a lightweight roster/staffing join,
// separate from Task.assigneeId (a specific task, not general project
// staffing). Not in the original PRD 11 list; added now that the roster
// explicitly needs it.
model ProjectAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_assignments")
}

// PRD 11: belongs to Project; belongs to User (assignee)
// order: not in the original PRD 11 field list, added to support PRD 9.3's
// drag-and-drop reordering — position within its (projectId, status) column,
// resequenced to a dense 0..n-1 range on every move (see lib/tasks/reorder.ts).
model Task {
  id         String     @id @default(uuid()) @db.Uuid
  projectId  String     @map("project_id") @db.Uuid
  assigneeId String?    @map("assignee_id") @db.Uuid
  title      String
  status     TaskStatus @default(TODO)
  order      Int        @default(0) @map("position")
  dueDate    DateTime?  @map("due_date")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id])
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

// PRD 11: belongs to Project
model File {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  uploaderId  String         @map("uploader_id") @db.Uuid
  storagePath String         @map("storage_path")
  visibility  FileVisibility @default(INTERNAL)
  type        String
  createdAt   DateTime       @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id])
  uploader User    @relation("FileUploader", fields: [uploaderId], references: [id])

  @@index([projectId])
  @@map("files")
}

// PRD 9.6: "a one-way status-comment thread with the office" — not in the
// original PRD 11 field list, added now that the portal explicitly needs it.
// One-way by construction: only staff (Owner/Admin/PM) can create a comment;
// the Client role only ever reads the thread. No reply/threading, no
// real-time delivery — that gap is deliberate (PRD 10 defers real-time chat
// to Phase 2 specifically to avoid websocket infrastructure).
model StatusComment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])
  author  User    @relation("StatusCommentAuthor", fields: [authorId], references: [id])

  @@index([projectId])
  @@map("status_comments")
}

// PRD 11: belongs to Project; has many EstimateLineItems
// archivedAt: soft-delete per CLAUDE.md (financial records are never hard-deleted).
// total is computed server-side from lineItems on every mutation, never entered
// directly — same "computed, not manual" discipline as Project.health.
// Per CLAUDE.md, an approved Estimate is immutable — changes create a new
// ChangeOrder record rather than an edit (see lib/estimates/immutability.ts).
model Estimate {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @map("project_id") @db.Uuid
  title      String?
  status     EstimateStatus @default(DRAFT)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  approvedAt DateTime?      @map("approved_at")
  archivedAt DateTime?      @map("archived_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  project      Project            @relation(fields: [projectId], references: [id])
  lineItems    EstimateLineItem[]
  changeOrders ChangeOrder[]
  invoices     Invoice[]

  @@index([projectId])
  @@map("estimates")
}

// PRD 9.5: line items with quantity, unit cost, markup.
model EstimateLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(12, 2)
  markup      Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  estimate Estimate @relation(fields: [estimateId], references: [id])

  @@index([estimateId])
  @@map("estimate_line_items")
}

// A modification to an approved Estimate, recorded as a brand-new record
// rather than an edit (PRD 19.2 glossary; CLAUDE.md immutability rule).
// ChangeOrders are themselves never edited or deleted once created — the
// audit trail is the whole point, so there's deliberately no update path.
model ChangeOrder {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  description String
  total       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  estimate  Estimate              @relation(fields: [estimateId], references: [id])
  createdBy User                  @relation("ChangeOrderCreator", fields: [createdById], references: [id])
  lineItems ChangeOrderLineItem[]

  @@index([estimateId])
  @@map("change_orders")
}

model ChangeOrderLineItem {
  id            String   @id @default(uuid()) @db.Uuid
  changeOrderId String   @map("change_order_id") @db.Uuid
  description   String
  quantity      Decimal  @db.Decimal(12, 2)
  unitCost      Decimal  @map("unit_cost") @db.Decimal(12, 2)
  markup        Decimal  @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  changeOrder ChangeOrder @relation(fields: [changeOrderId], references: [id])

  @@index([changeOrderId])
  @@map("change_order_line_items")
}

// PRD 11: belongs to Project
// archivedAt: soft-delete per CLAUDE.md (financial records are never hard-deleted).
// description + dueDate aren't in the original PRD 11 field list — description
// is needed to tell milestone/ad-hoc invoices apart in a list, and dueDate is
// needed for the reconciliation job to ever mark anything OVERDUE (PRD 17).
model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  estimateId      String?       @map("estimate_id") @db.Uuid
  description     String
  amount          Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(PENDING)
  dueDate         DateTime?     @map("due_date")
  stripePaymentId String?       @map("stripe_payment_id")
  stripeSessionId String?       @map("stripe_session_id")
  archivedAt      DateTime?     @map("archived_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id])
  estimate Estimate? @relation(fields: [estimateId], references: [id])

  @@index([projectId])
  @@index([estimateId])
  @@map("invoices")
}

// PRD 11: belongs to User
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  readAt    DateTime? @map("read_at")
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// PRD 11: belongs to Company
// entityId is a polymorphic reference (no FK constraint) to the affected row,
// identified alongside entityType.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  actor   User    @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([companyId])
  @@map("audit_logs")
}

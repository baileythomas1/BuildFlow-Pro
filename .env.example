DATABASE_URL="postgresql://user:password@localhost:5432/buildflow_pro?schema=public"

# JWT signing secrets — generate distinct random values per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Supabase Storage — service key is server-only, never expose to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# Stripe — use a restricted key (rk_...) scoped to Checkout Sessions in
# production; sk_test_... is fine for local dev. Webhook secret comes from
# `stripe listen` locally or the Dashboard's webhook endpoint in production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Shared secret Vercel Cron presents to trigger /api/cron/reconcile-invoices
CRON_SECRET=""
